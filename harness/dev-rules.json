  "test_rules_note": "Playwright 테스트 제목에 [규칙ID]와 [S{화면}]을 붙인다. 예: '[R-ui][S13] 학생 홈에 stock-intake 0개'. judge는 규칙마다 테스트 ≥1개 + 전부 통과를 본다. N1-d는 화면 14(회원가입)가 대상일 때만. 둘러보기 테스트는 [GM-ui][S13g]·[GM-db][S*] 처럼 화면 번호 뒤에 g.",
  "report_only": [
    "V1"
  ],
  "commands": {
    "Q1": [
      "npm run typecheck",
      "npm run lint",
      "npm run test"
    ],
    "Q2": [
      "npm run build"
    ],
    "T1": "node scripts/gen-tokens.mjs --check",
    "e2e": "npx playwright test --reporter=json"
  },
  "scan": {
    "T2_dirs": [
      "app",
      "components"
    ],
    "T2_exts": [
      ".tsx",
      ".ts",
      ".css"
    ],
    "T2_exempt_files": [
      "styles/tokens.css"
    ],
    "T2_patterns": {
      "hex": "#[0-9a-fA-F]{3,8}\\b",
      "px": "\\b\\d+(\\.\\d+)?px\\b",
      "rgb": "\\brgba?\\("
    },
    "T2_allow_line": "@media",
    "secret_env_names": [
      "NEIS_API_KEY",
      "GEMINI_API_KEY",
      "SUPABASE_SERVICE_ROLE_KEY"
    ],
    "secret_allowed_dirs": [
      "app/api",
      "lib/server",
      "scripts",
      "tests"
    ],
    "public_env_allowed": [
      "NEXT_PUBLIC_SUPABASE_URL",
      "NEXT_PUBLIC_SUPABASE_ANON_KEY",
      "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY"
    ],
    "bundle_dir": ".next/static",
    "bundle_patterns": {
      "gemini_key": "AIza[0-9A-Za-z_\\-]{35}",
      "key_like_hex": "KEY.{0,24}[0-9a-f]{32}",
      "service_role": "service_role"
    },
    "skip_dirs": [
      "node_modules",
      ".next",
      ".git",
      "runs",
      "test-results",
      "playwright-report"
    ]
  },
  "retries": {
    "D1": 3,
    "D2": 3,
    "D3": 3,
    "D4": 3
  },
  "hash_scope": {
    "include": [
      "harness",
      "design",
      "CLAUDE.md"
    ],
    "exclude": [
      "harness/tests"
    ],
    "exclude_names": [
      "__pycache__"
    ]
  },
