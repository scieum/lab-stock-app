# 공개 (브라우저에 노출 가능)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용 (app/api/**, lib/server/** 에서만 읽는다. NEXT_PUBLIC_ 금지)
NEIS_API_KEY=
GEMINI_API_KEY=
# 선택: 실험 매뉴얼 AI 추출 모델 (비우면 lib/server/gemini.ts 의 기본 모델)
GEMINI_MODEL=
SUPABASE_SERVICE_ROLE_KEY=

# 테스트 계정 (scripts/seed-test-users.mjs --env 가 .env.local에 무작위로 채운다. 값은 커밋 금지)
TEST_STUDENT_EMAIL=
TEST_STUDENT_PASSWORD=
TEST_TEACHER_EMAIL=
TEST_TEACHER_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_SCHOOL_B_EMAIL=
TEST_SCHOOL_B_PASSWORD=
